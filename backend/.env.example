# Twitch Developer Console credentials
# Register an app at https://dev.twitch.tv/console/apps to get these
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# MySQL connection (defaults below match docker-compose.yml for local dev)
DATABASE_URL=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=secret
DATABASE_INIT=always
